{
  "name": "tekk-life",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TEKK LIFE – Management-Simulation über eine fiktive Underground-Tekno-/Freetekk-Szene",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build",
    "build:single": "npm run build && node scripts/single-file.mjs dist dist-single/tekk-life.html"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "immer": "^10.2.0",
    "lucide-react": "^1.61.0",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
